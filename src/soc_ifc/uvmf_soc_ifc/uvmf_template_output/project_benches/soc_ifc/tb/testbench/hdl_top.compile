incdir:
  - ${uvm_path}/src
  - .
needs:
  - $UVMF_HOME/uvmf_base_pkg/uvmf_base_pkg_hdl.compile
  - ../parameters/soc_ifc_parameters_pkg.compile
  - ../../../../verification_ip/interface_packages/soc_ifc_ctrl_pkg/soc_ifc_ctrl_hdl.compile
  - ../../../../verification_ip/interface_packages/cptra_ctrl_pkg/cptra_ctrl_hdl.compile
  - ../../../../verification_ip/interface_packages/ss_mode_ctrl_pkg/ss_mode_ctrl_hdl.compile
  - ../../../../verification_ip/interface_packages/soc_ifc_status_pkg/soc_ifc_status_hdl.compile
  - ../../../../verification_ip/interface_packages/cptra_status_pkg/cptra_status_hdl.compile
  - ../../../../verification_ip/interface_packages/ss_mode_status_pkg/ss_mode_status_hdl.compile
  - ../../../../verification_ip/interface_packages/mbox_sram_pkg/mbox_sram_hdl.compile
src:
  # pragma uvmf custom sha_status_before begin
  - soc_ifc_sha_status_if.sv
  # pragma uvmf custom sha_status_before end
  - hdl_top.sv
  # pragma uvmf custom sha_sva_after begin
  - soc_ifc_sha_acc_state_sva.sv
  # pragma uvmf custom sha_sva_after end
